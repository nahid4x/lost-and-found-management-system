# ============================================================================
# FindIt environment template. Copy to .env and fill in (never commit .env).
# Fastest way: run ./scripts/init-env.sh  -> it generates every random secret for you,
# you only add the Cloudinary / SMTP values below.
# Services refuse to boot when a secret is missing, shorter than 32 chars or looks like a placeholder.
# ============================================================================

# ---- Public settings (not secret) ----
APP_URL=https://localhost
# Exact browser origins allowed to call the API (comma separated, no wildcard)
CORS_ORIGINS=https://localhost
NODE_ENV=production
LOG_LEVEL=info

# ---- Secrets: generate with `openssl rand -hex 32` (all different) ----
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# ---- Databases (hex only: they are embedded in connection URLs) ----
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_AUTH_PASSWORD=CHANGE_ME
MONGO_ITEMS_PASSWORD=CHANGE_ME
MONGO_MATCHING_PASSWORD=CHANGE_ME
MONGO_CLAIMS_PASSWORD=CHANGE_ME
MONGO_REALTIME_PASSWORD=CHANGE_ME
MONGO_NOTIFY_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ---- Cloudinary (server side only; the browser never sees these) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Nodemailer). Leave SMTP_URL empty to log-only (no email leaves the machine) ----
SMTP_URL=
MAIL_FROM="FindIt <no-reply@example.com>"

# ---- Calls: STUN/TURN ----
STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN (coturn). TURN_URLS example: turn:turn.example.com:3478?transport=udp
TURN_URLS=
TURN_SECRET=CHANGE_ME
TURN_REALM=findit.local

# ---- Matching engine ----
MATCH_THRESHOLD=45
MATCH_RADIUS_KM=2

# ---- Seed admin (used only by `docker compose run` at seed time; never stored here) ----
# ADMIN_EMAIL / ADMIN_PASSWORD are passed on the command line, see README.
